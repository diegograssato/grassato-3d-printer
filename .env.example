SECRET_KEY=django-insecure-grassato-3d-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (sqlite3 por padrão; use mysql para produção)
DB_ENGINE=sqlite3
DB_NAME=grassato3d
DB_USER=grassato
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Superusuário Django (criado automaticamente via docker-compose)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@grassato.local
DJANGO_SUPERUSER_PASSWORD=admin123
